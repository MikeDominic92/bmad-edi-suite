{
  "name": "bmad-edi-suite",
  "version": "1.0.0",
  "description": "BMAD-EDI Enterprise Investigation Suite - AI-powered EDI ticket investigation workflow automation",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cheerio": "^1.1.2",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "electron-is-dev": "^3.0.1",
    "jsdom": "^27.2.0",
    "patchright": "^1.56.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^9.0.3"
  },
  "keywords": [
    "edi",
    "investigation",
    "bmad",
    "automation",
    "ai"
  ],
  "author": "Michael Hoang",
  "license": "MIT"
}
