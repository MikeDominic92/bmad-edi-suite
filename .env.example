# BMAD-EDI Suite Configuration

# Anthropic Claude API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# NotebookLM Notebook URL (required)
# Your WebEDI Knowledge Base notebook
NOTEBOOKLM_NOTEBOOK_URL=https://notebooklm.google.com/notebook/fe1e5d80-9cf6-45fe-a974-0b5525c6b403

# Tickets Base Path (required)
# Path to your tickets directory
TICKETS_BASE_PATH=C:/Users/jae2j/Documents/tickets

# WebSocket Port (optional)
# Default: 8080
WEBSOCKET_PORT=8080

# Environment (optional)
# Values: development, production
NODE_ENV=development
