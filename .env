# BMAD-EDI Suite v2.1 Configuration
# Trigger-Based Mode - Uses Claude Code instead of API key

# Tickets Base Path (required)
TICKETS_BASE_PATH=C:/Users/jae2j/Documents/tickets

# WebSocket Port (optional)
WEBSOCKET_PORT=8080

# Environment (optional)
NODE_ENV=development

# === v2.1 TRIGGER MODE ===
# No API key needed! The app creates trigger files that
# Claude Code (running in VS Code) detects and auto-executes /bmadedi
#
# How it works:
# 1. App creates .trigger file in Documents/tickets/.triggers/
# 2. Claude Code hook detects trigger
# 3. Claude Code auto-runs /bmadedi command
# 4. Results saved to resolution/ folder
# 5. App displays results
#
# Setup:
# 1. Make sure Claude Code is running in VS Code
# 2. Hooks are configured in C:\Users\jae2j\.claude\hooks\
# 3. Python watcher (optional): pip install watchdog
# 4. Start app: npm run dev
# 5. Click "Start Investigation" - Claude Code will handle it!

# === DEPRECATED (v2.0 - Claude SDK) ===
# These are no longer needed in v2.1
# ANTHROPIC_API_KEY=your_api_key_here
# NOTEBOOKLM_NOTEBOOK_URL=https://notebooklm.google.com/notebook/...
